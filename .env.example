# Copy to .env at the repo root. Every app reads this one file.

# Postgres from docker compose (host port 5433 so it doesn't clash with a local Postgres)
DATABASE_URL=postgresql://shipyard:shipyard@localhost:5433/shipyard

# Auth.js session encryption key. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# The API uses the same secret to read the session cookie.
AUTH_SECRET=

# GitHub OAuth app — create at https://github.com/settings/developers
#   Homepage URL:  http://localhost:3000
#   Callback URL:  http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Where the dashboard reaches the API (server-side fetches)
API_URL=http://localhost:4000
API_PORT=4000
